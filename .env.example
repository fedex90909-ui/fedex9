# ----------------------------------------------------------------------------
# FedEx demo — environment variables
#
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# NEVER commit a real `.env`. In production, set these in
# Netlify → Site configuration → Environment variables.
# All values below are placeholders — replace with your own.
# ----------------------------------------------------------------------------

# ---- Administration --------------------------------------------------------
# Comma-separated list of emails that receive the `admin` role when they
# register or sign in. Change this to YOUR email before deploying.
VITE_ADMIN_EMAIL=admin@your-domain.com

# ---- Future backend (Netlify Functions / database) -------------------------
# The demo front end persists data in the browser. When you connect a real
# backend (netlify/functions + Postgres/Neon/Supabase), these are the secrets
# it will need. They are server-only: never prefix them with VITE_.
#
# DATABASE_URL=postgres://user:password@host:5432/dbname
# AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# ---- Future payment provider ----------------------------------------------
# The current card flow is a demo blueprint. When you connect a real gateway,
# add its keys here (server-side key only — publishable keys may use VITE_).
#
# PAYMENTS_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# PAYMENTS_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
